# Copy to .env and fill in the values. .env is local and never committed.

# DeepSeek (the only LLM; see adr-006)
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_URL=https://api.deepseek.com

# GraphDB (see adr-010, with the adr-007 tool loop as fallback).
# KG_USER must be a read-only GraphDB user (RSK-007).
KG_HOST=http://host.docker.internal:7200
KG_REPOSITORY=portfolio
KG_USER=
KG_PASSWORD=
KG_AGENT_ID=2689c209-4f97-4a07-bfd9-39d3cdd5cf92
KG_CHAT_MODE=chat
# Optional connector limits:
# KG_CHAT_TIMEOUT_SECONDS=120
# KG_TOOL_MAX_ITERATIONS=8

# SQLite database for sessions, history and reports (see adr-004)
SQLITE_PATH=backend/data/app.sqlite3
