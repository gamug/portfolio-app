# Copy to .env and fill in the values. .env is local and never committed.

# DeepSeek (the only LLM; see adr-006)
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_URL=https://api.deepseek.com

# GraphDB (see adr-007). KG_USER must be a read-only GraphDB user (RSK-007).
KG_HOST=http://host.docker.internal:7200
KG_REPOSITORY=portfolio
KG_USER=
KG_PASSWORD=

# SQLite database for sessions, history and reports (see adr-004)
SQLITE_PATH=backend/data/app.sqlite3
