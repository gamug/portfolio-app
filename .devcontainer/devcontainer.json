{
  "name": "portfolio-app-new",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "forwardPorts": [
    5173,
    8000
  ],
  "postCreateCommand": "uv sync --locked --directory backend && pnpm --dir frontend install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "anthropic.claude-code"
      ]
    }
  }
}
